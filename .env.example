# Copy this file to .env and replace placeholder values.
GROQ_API_KEY=your_groq_api_key_here

# Optional model configuration
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile

# Local persistence
# DB_PATH=database/financial_agent.db
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_DOCUMENTS_DIR=data/document_chroma
# PRIVATE_DOCUMENT_DIR=data/private_documents

# Public data providers
# SEC_USER_AGENT=Fintoran/1.0 your-real-contact@example.com
FRED_API_KEY=
SEC_USER_AGENT=

# Runtime controls
MAX_SUPERVISOR_STEPS=6
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_BYTES=15728640
# Agent retry controls
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BASE_DELAY=0.5
MAX_SUPERVISOR_STEPS=6

# Private document storage
PRIVATE_DOCUMENT_DIR=./data/private_documents
CHROMA_DOCUMENTS_DIR=./data/document_chroma
MAX_UPLOAD_BYTES=10485760
